# Banco (libSQL/SQLite). Local = arquivo; produção = URL do Turso.
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# Segredo para assinar a sessão de login (gere com: openssl rand -hex 32)
AUTH_SECRET=troque-por-uma-chave-aleatoria-longa

# Segredo que o Make envia no header x-webhook-secret
WEBHOOK_SECRET=troque-por-um-segredo-de-webhook

# IA — o painel transcreve o áudio (Whisper/OpenAI) e escreve o release (Claude/Anthropic)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo do Claude (padrão: claude-sonnet-5). Suba pra claude-opus-5 se quiser.
# AI_MODEL=claude-sonnet-5
